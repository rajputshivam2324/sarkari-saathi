# Backend settings. Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real keys.
# The frontend has its own file: frontend/.env (see frontend/.env.example).

# --- Database (Postgres) -----------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- Gnani: speech only (STT + TTS) -----------------------------------------------------------
GNANI_API_KEY=
GNANI_STT_LANGUAGE=indic-auto
GNANI_EVON_ENABLED=false
GNANI_EVON_URL=

# --- Conversation LLM -------------------------------------------------------------------------
# Gemini through its OpenAI-compatible endpoint (no SDK). Add up to 8 keys, ideally from SEPARATE Google
# projects (quota is counted per project). Requests are spread across them; a key that hits its limit
# rests while the others carry on. If every Gemini key is resting, Groq is used when GROQ_API_KEY is set.
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
GEMINI_API_KEY6=
GEMINI_API_KEY7=
GEMINI_API_KEY8=
GEMINI_MODEL=gemini-2.5-flash
# Used for a key whose Google account can no longer call GEMINI_MODEL ("no longer available to new users")
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# none (fastest) | low | medium | high
GEMINI_REASONING_EFFORT=none
# Optional spare provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# --- Cache (Upstash Redis REST). Without it the cache lives in memory and resets on restart -----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or TCP: rediss://default:TOKEN@xxxx.upstash.io:6379
UPSTASH_REDIS_URL=

# --- myScheme.gov.in ---------------------------------------------------------------------------
MYSCHEME_API_KEY=
MYSCHEME_API_BASE=https://api.myscheme.gov.in

# --- App ---------------------------------------------------------------------------------------
APP_NAME=Sarkari Saathi
ENVIRONMENT=development
# Browser origin allowed by CORS (your frontend URL)
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_EXPIRE_HOURS=72
