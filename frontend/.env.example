# Frontend settings (Vite). Copy to frontend/.env. These values are compiled into the public JavaScript:
# never put a secret here. The backend has its own file: backend/.env.

# REST API base. Leave as /api in development: the Vite dev server forwards /api to http://127.0.0.1:8000.
# In production set the full backend URL, for example: https://sarkari-api.shivamio.in
VITE_API_URL=/api

# WebSocket base for live voice. In production use wss://, for example: wss://sarkari-api.shivamio.in
VITE_WS_URL=ws://127.0.0.1:8000
