DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

GNANI_API_KEY=
GNANI_EVON_URL=
GNANI_EVON_ENABLED=false
GNANI_STT_LANGUAGE=indic-auto

# Conversation LLM: Groq. Gnani stays for speech (STT + TTS). Without a key the app still works on a
# built-in rule-based dialogue, but replies sound far more natural with a model.
GROQ_API_KEY=
# Production models on Groq today: openai/gpt-oss-120b (default), openai/gpt-oss-20b (faster, cheaper)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Upstash Redis (REST preferred)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Or TCP: rediss://default:TOKEN@xxxx.upstash.io:6379
UPSTASH_REDIS_URL=

MYSCHEME_API_KEY=
MYSCHEME_API_BASE=https://api.myscheme.gov.in

APP_NAME=Sarkari Saathi
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:8000
SECRET_KEY=change-me
JWT_EXPIRE_HOURS=72
